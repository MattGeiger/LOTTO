# Required for Vercel Production
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# Separate Neon database/project for public Arcade high scores.
ARCADE_DATABASE_URL=postgresql://arcade_scores_runtime:pass@host/db?sslmode=require
AUTH_SECRET=<generate-with-openssl-rand-base64-32>
RESEND_API_KEY=re_xxxxxxxxxx
EMAIL_FROM=login@williamtemple.app
ADMIN_EMAIL_DOMAIN=williamtemple.org
# Added automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxx

# Configuration
AUTH_TRUST_HOST=true
AUTH_BYPASS=false
NEXT_PUBLIC_ADMIN_OPTIMISTIC_UI=false
# Disabled by default. Configure each agency's existing production hub and
# verify publication before enabling its independent realtime/snapshot gates.
LOTTO_REALTIME_SHADOW_PUBLISH=false
# RC.7 public appearance/language/pack isolation; enable only after publishing
# and validating this release on the intended agency's existing Cloudflare hub.
LOTTO_PUBLIC_CONFIGURATION_SNAPSHOT_ENABLED=false
# WTH's migrated production resource; never recreate the retired personal hub.
# LOTTO_REALTIME_HUB_URL=https://lotto-realtime-production.technology-818.workers.dev
# LOTTO_REALTIME_EXPECTED_HUB_HOST=lotto-realtime-production.technology-818.workers.dev
# LOTTO_REALTIME_AGENCY_ID=william-temple-house
# LOTTO_REALTIME_PUBLISH_TOKEN=stored_only_in_the_agency_secret_store
# LOTTO_REALTIME_PUBLISH_TIMEOUT_MS=1500
# Optional; app defaults to the production FEED public endpoint when omitted.
# NEXT_PUBLIC_FEED_PUBLIC_INVENTORY_URL=https://feed.williamtemple.app/api/public/inventory.json
NODE_ENV=production
